# ===========================================
# Farmer League Bot - Variables d'environnement
# Copie ce fichier en .env et remplis les valeurs
# ===========================================

# Token du bot (OBLIGATOIRE)
# https://discord.com/developers/applications > Ton app > Bot > Copy Token
DISCORD_TOKEN=VOTRE_TOKEN_ICI

# ID de l'application Discord = ID du BOT (OBLIGATOIRE)
# Developer Portal > Ton app > Application ID (en haut)
CLIENT_ID=VOTRE_CLIENT_ID_ICI

# ID du serveur Discord (OBLIGATOIRE)
# Clic droit sur le serveur > Copier l'identifiant du serveur
GUILD_ID=VOTRE_GUILD_ID_ICI

# Ton ID Discord personnel (admin) - PAS le même que CLIENT_ID !
# Clic droit sur ton nom dans Discord > Copier l'ID utilisateur
ADMIN_ID=TON_ID_DISCORD_ICI

# Base de données (OPTIONNEL - si migration vers PostgreSQL)
# DATABASE_URL=postgresql://user:password@host:5432/database

# Config
NODE_ENV=production
